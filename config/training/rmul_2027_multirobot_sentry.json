    "max_grad_norm": 0.5,
    "net_arch": {
      "pi": [
        128,
        128
      ],
      "vf": [
        128,
        128
      ]
    }
  },
  "reward_scale": 0.05,
  "n_envs": 1,
  "selection_reward": {
    "switch_cost": 0.002,
    "return_cost": 0.03,
    "return_window_s": 0.1,
