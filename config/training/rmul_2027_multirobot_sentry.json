{
  "version": 1,
  "algorithm": "maskable_ppo",
  "policy_kind": "asymmetric_mlp",
  "seed": 17,
  "device": "cpu",
  "torch_threads": 1,
  "total_timesteps": 1024,
  "checkpoint_updates": 4,
  "environment": {
    "episode_steps": 3000,
    "scene_seed": 17,
    "decision_clock": {
      "min_interval_ms": 50,
      "max_interval_ms": 100,
      "resample": "decision",
      "seed": 17
    },
    "scenario": {
      "duel": {
        "controlled": {
          "preset": "sentry"
        },
        "target": {}
      },
      "unlimited_heat": false,
      "measurements": {
        "noise_std_px": 0.25,
        "latency_ms": 20,
        "dropout_probability": 0.0
      }
    },
    "task": "multi_robot_fire",
    "action_mode": "joint",
    "selection_memory": true,
    "observation_mode": "asymmetric_v1"
  },
  "ppo": {
    "n_steps": 1024,
